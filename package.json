{
  "name": "playwright-test",
  "version": "1.0.0",
  "description": "Enterprise ITSM Helpdesk Copilot Playwright Test Automation",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium --headed",
    "test:headed": "playwright test --project=chromium --headed",
    "test:chromium": "playwright test --project=chromium --headed",
    "test:chrome": "playwright test --project=\"Google Chrome\" --headed",
    "test:edge": "playwright test --project=\"Microsoft Edge\" --headed",
    "test:firefox": "playwright test --project=firefox --headed",
    "test:webkit": "playwright test --project=webkit --headed",
    "test:all-browsers": "playwright test --headed",

    "test:smoke": "playwright test tests/smoke/ --project=chromium --headed",
    "test:smoke:admin": "playwright test tests/smoke/smoke.spec.js --grep \"Admin user can authenticate\" --project=chromium --headed",
    "test:smoke:itstaff": "playwright test tests/smoke/smoke.spec.js --grep \"IT Staff user can authenticate\" --project=chromium --headed",
    "test:smoke:employee": "playwright test tests/smoke/smoke.spec.js --grep \"Employee user can authenticate\" --project=chromium --headed",
    "test:login:matrix": "playwright test tests/smoke/login-matrix.spec.js --project=chromium --headed && node scripts/update-login-matrix-excel.js",

    "test:e2e": "playwright test tests/e2e/ --project=chromium --headed",

    "test:admin:itsm": "playwright test tests/admin/dashboard.spec.js --project=chromium --headed",
    "test:admin:tq": "playwright test tests/admin/ticket-queue.spec.js --project=chromium --headed",
    "test:admin:kb": "playwright test tests/admin/ticket-queue.spec.js --project=chromium --headed",
    "test:admin:lm": "playwright test tests/admin/leave-management.spec.js --project=chromium --headed",
    "test:admin:am": "playwright test tests/admin/alert-management.spec.js --project=chromium --headed",
    "test:admin:um": "playwright test tests/admin/user-management.spec.js --project=chromium --headed",
    "test:admin:ism": "playwright test tests/admin/settings.spec.js --project=chromium --headed",
    "test:admin:kpi": "playwright test tests/admin/kpi-validation.spec.js --project=chromium --headed",
    "test:admin:ai-helpdesk": "playwright test tests/admin/ai-helpdesk.spec.js --project=chromium --headed",

    "test:auth:forgot-password": "playwright test tests/auth/forgot-password.spec.js --project=chromium --headed",
    "test:auth:fp": "playwright test tests/auth/forgot-password.spec.js --project=chromium --headed",

    "test:itstaff:itd": "playwright test tests/it-staff/dashboard.spec.js --project=chromium --headed",
    "test:itstaff:itstq": "playwright test tests/it-staff/ticket-queue.spec.js --project=chromium --headed",
    "test:itstaff:ac": "playwright test tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",
    "test:itstaff:lr": "playwright test tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",
    "test:itstaff:ai-helpdesk": "playwright test tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",
    "test:itstaff:rtc": "playwright test tests/realtime/ticket-realtime-chat.spec.js --project=chromium --headed",

    "test:employee:ed": "playwright test tests/employee/dashboard.spec.js --project=chromium --headed",
    "test:employee:emt": "playwright test tests/employee/my-tickets.spec.js --project=chromium --headed",
    "test:employee:ai-helpdesk": "playwright test tests/employee/ai-helpdesk.spec.js --project=chromium --headed",
    "test:employee:rtc": "playwright test tests/realtime/ticket-realtime-chat.spec.js --project=chromium --headed",

    "test:ai-helpdesk:chat": "playwright test tests/admin/ai-helpdesk.spec.js tests/employee/ai-helpdesk.spec.js tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",
    "test:ai-helpdesk:all": "playwright test tests/admin/ai-helpdesk.spec.js tests/employee/ai-helpdesk.spec.js tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",

    "test:realtime:chat": "playwright test tests/realtime/ticket-realtime-chat.spec.js --project=chromium --headed",

    "test:all-sequential": "node run-all-tests.js",
    "test:all-sequential:resume": "node run-all-tests.js --resume",
    "test:all-sequential:dry": "node run-all-tests.js --dry-run",

    "test:parallel": "node run-parallel-tests.js",
    "test:parallel:admin": "node run-parallel-tests.js --only=admin",
    "test:parallel:itstaff": "node run-parallel-tests.js --only=itstaff",
    "test:parallel:employee": "node run-parallel-tests.js --only=employee",
    "test:parallel:kpi": "node run-parallel-tests.js --only=kpi",
    "test:parallel:fp": "node run-parallel-tests.js --only=fp",
    "test:parallel:rtc": "node run-parallel-tests.js --only=rtc",
    "test:parallel:chat": "node run-parallel-tests.js --only=chat",
    "test:parallel:dry": "node run-parallel-tests.js --dry-run",

    "report": "playwright show-report",

    "test:admin:tickets": "playwright test tests/admin/ticket-queue.spec.js --project=chromium --headed",
    "test:admin:tickets:headed": "playwright test tests/admin/ticket-queue.spec.js --project=chromium --headed",
    "test:admin:alerts": "playwright test tests/admin/alert-management.spec.js --project=chromium --headed",
    "test:admin:alerts:headed": "playwright test tests/admin/alert-management.spec.js --project=chromium --headed",
    "test:admin:leaves": "playwright test tests/admin/leave-management.spec.js --project=chromium --headed",
    "test:admin:leaves:headed": "playwright test tests/admin/leave-management.spec.js --project=chromium --headed",
    "test:admin:users": "playwright test tests/admin/user-management.spec.js --project=chromium --headed",
    "test:admin:users:headed": "playwright test tests/admin/user-management.spec.js --project=chromium --headed",
    "test:admin:settings": "playwright test tests/admin/settings.spec.js --project=chromium --headed",
    "test:admin:settings:headed": "playwright test tests/admin/settings.spec.js --project=chromium --headed",
    "test:admin:kpi--headed": "playwright test tests/admin/kpi-validation.spec.js --project=chromium --headed",
    "test:admin:ai-helpdesk:headed": "playwright test tests/admin/ai-helpdesk.spec.js --project=chromium --headed",
    "test:admin:ai-helpdesk--headed": "playwright test tests/admin/ai-helpdesk.spec.js --project=chromium --headed",
    "test:admin:ai-judge": "playwright test tests/admin/ai-intelligence-check.spec.js --project=chromium --headed",
    "test:admin:dashboard": "playwright test tests/admin/dashboard.spec.js --project=chromium --headed",
    "test:admin:dashboard:headed": "playwright test tests/admin/dashboard.spec.js --project=chromium --headed",
    "test:admin:type2--headed": "playwright test tests/admin/ --grep-invert \"type1\" --project=chromium --headed",

    "test:itstaff:dashboard": "playwright test tests/it-staff/dashboard.spec.js --project=chromium --headed",
    "test:itstaff:dashboard:headed": "playwright test tests/it-staff/dashboard.spec.js --project=chromium --headed",
    "test:itstaff:tickets": "playwright test tests/it-staff/ticket-queue.spec.js --project=chromium --headed",
    "test:itstaff:tickets:headed": "playwright test tests/it-staff/ticket-queue.spec.js --project=chromium --headed",
    "test:itstaff:ai-helpdesk:headed": "playwright test tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",
    "test:itstaff:ai-helpdesk--headed": "playwright test tests/it-staff/ai-helpdesk.spec.js --project=chromium --headed",
    "test:itstaff:type2--headed": "playwright test tests/it-staff/ --grep-invert \"type1\" --project=chromium --headed",

    "test:employee:dashboard": "playwright test tests/employee/dashboard.spec.js --project=chromium --headed",
    "test:employee:dashboard:headed": "playwright test tests/employee/dashboard.spec.js --project=chromium --headed",
    "test:employee:tickets": "playwright test tests/employee/my-tickets.spec.js --project=chromium --headed",
    "test:employee:tickets:headed": "playwright test tests/employee/my-tickets.spec.js --project=chromium --headed",
    "test:employee:ai-helpdesk:headed": "playwright test tests/employee/ai-helpdesk.spec.js --project=chromium --headed",
    "test:employee:ai-helpdesk--headed": "playwright test tests/employee/ai-helpdesk.spec.js --project=chromium --headed",
    "test:employee:type2--headed": "playwright test tests/employee/ --grep-invert \"type1\" --project=chromium --headed",

    "test:realtime:chat:headed": "playwright test tests/realtime/ticket-realtime-chat.spec.js --project=chromium --headed",
    "test:auth:forgot-password:headed": "playwright test tests/auth/forgot-password.spec.js --project=chromium --headed"
  },
  "keywords": [
    "playwright",
    "itsm",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2"
  },
  "dependencies": {
    "chromium": "^3.0.3",
    "excel": "^0.1.7",
    "exceljs": "^3.4.0"
  }
}
